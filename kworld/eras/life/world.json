 "journal": {
  "flake": {
   "title": "뗀석기",
   "note": "돌을 돌로 쳐서 날을 세웠다. 이 손이 기억한다."
  },
  "spear": {
   "title": "창",
   "note": "날 세운 돌로 가지를 깎았다. 혼자 사냥은 여전히 안 된다."
  },
  "waterhole": {
   "title": "기다리는 사냥",
   "note": "짐승은 물을 마시러 늘 같은 곳에 온다. 덤불에 숨어 기다리면 쫓지 않아도 된다. 바람이 짐승 쪽으로 불면 냄새로 들킨다."
  },
  "drive": {
   "title": "몰이사냥",
   "note": "혼자서는 큰 짐승을 못 잡는다. 여럿이 소리를 지르며 좁은 골짜기로 몰고, 끝에서 기다린 사람이 창을 쓴다. 무리가 함께 사는 까닭."
  },
  "gather": {
   "title": "캐고 줍기(채집)",
   "note": "사냥은 실패가 많다. 습지의 뿌리·새알·조개, 숲의 열매·도토리가 매일의 밥이었다. 고기보다 캔 것이 더 많았다는 생각도 있다."
  },
  "hidebeast": {
   "title": "큰 짐승",
   "note": "한반도 구석기 동굴에서 동굴곰·호랑이·표범 같은 큰 짐승 뼈가 사람 흔적과 함께 나온다. 사람은 이길 수 없을 때 숨었다."
  },
  "pebble": {
   "title": "강자갈 돌감",
   "note": "연천 전곡리 한탄강가에서 주먹도끼가 나왔다. 강물에 굴러 단단해진 규암 자갈을 깨서 만들었다. 물이 줄어야 좋은 자갈이 드러난다."
  },
  "heungsu": {
   "title": "흥수아이",
   "note": "청원 두루봉 동굴(흥수굴)에서 어린아이 뼈가 나왔다. 아이를 판판한 돌 위에 눕히고 고운 흙을 뿌린 것으로 보이고, 꽃가루가 나와 꽃을 놓았다고 보는 사람도 있다. 떠난 사람을 아낀 마음."
  },
  "move": {
   "title": "옮겨 다니는 삶",
   "note": "먹을 것이 줄면 무리는 짐승과 열매를 따라 옮겨 갔다. 막집은 잠깐 머무는 집. 그래서 구석기 유적은 강가·동굴에 흩어져 있다."
  },
  "obsidian": {
   "title": "흑요석",
   "note": "화산 유리. 깨면 아주 날카롭다. 백두산에서 난 흑요석이 수백 km 떨어진 남쪽 구석기 유적에서도 나온다 — 무리와 무리가 멀리 주고받았다."
  },
  "oldfire": {
   "title": "바위 그늘",
   "note": "구석기 사람들은 동굴이나 바위 그늘(바위가 지붕처럼 튀어나온 곳)에 살았다. 같은 자리를 다른 무리가 몇 천 년에 걸쳐 거듭 썼다 — 공주 석장리·청원 두루봉 동굴에 불 자리와 뗀석기가 층층이 남았다."
  },
  "smoke_far": {
   "title": "다른 무리",
   "note": "한 무리는 스무 명에서 서른 명쯤이었다. 무리와 무리는 가끔 만나 돌과 짝을 주고받았다 — 혼자 사는 무리는 오래 못 갔다."
  },
  "bigtrack": {
   "title": "큰 짐승",
   "note": "구석기 사람의 가장 큰 위험은 추위와 큰 짐승이었다. 동굴곰·호랑이·하이에나 뼈가 사람이 살던 동굴에서 함께 나온다. 자국과 긁힌 나무를 읽는 눈이 목숨이었다."
  },
  "longnight": {
   "title": "말로 전한다",
   "note": "글자가 없었다. 사냥하는 법·불 지키는 법·돌 깨는 법은 어른의 말과 손짓, 흉내로 아이에게 넘어갔다. 동굴 벽화도 그렇게 그려졌다."
  },
  "fire_get": {
   "title": "불 얻기",
   "note": "구석기 사람은 처음부터 불을 피울 줄 몰랐다. 번개·산불로 난 불에서 불씨를 가져와 꺼지지 않게 지켰다. 불은 짐승을 쫓고, 고기를 익히고, 추위를 막았다. 막집 자리마다 불 땐 자리가 나온다."
  },
  "icecold": {
   "title": "빙하기 추위",
   "note": "구석기 시대 대부분은 지금보다 훨씬 추운 빙하기였다. 겨울엔 털가죽·불·바람을 막는 바위 밑이 목숨이었다. 공주 석장리 막집 자리에서도 불 땐 자리가 나온다."
  },
  "bonetool": {
   "title": "뼈 연모",
   "note": "돌만이 아니라 짐승의 뼈·뿔로도 도구를 만들었다. 제천 점말동굴·청원 두루봉에서 뼈를 깎고 다듬은 연모가 나온다. 뼈는 가볍고 뾰족하게 만들기 좋다."
  }
 },
