 "journal": {
  "sickle": {
   "title": "반달돌칼",
   "note": "갈판에 갈아 만든 반달 모양 칼. 이삭만 딴다."
  },
  "sword": {
   "title": "비파형동검",
   "note": "구리와 주석을 녹여 부었다. 농기구는 여전히 돌 — 청동은 귀하다."
  },
  "dolmen": {
   "title": "고인돌",
   "note": "수십 명이 끌어 올린 돌. 한 사람을 위해."
  },
  "rockart": {
   "title": "바위에 새긴 바람",
   "note": "울주 천전리·반구대 바위에는 사슴·고래·사람·소용돌이가 새겨져 있다. 농사를 짓는 사람은 비와 해를 빌었고, 비는 자리는 우두머리와 제사 맡은 사람의 자리가 됐다."
  },
  "moat": {
   "title": "환호 — 마을 둘레 도랑",
   "note": "울산 검단리 청동기 마을은 둘레에 도랑(환호)을 팠다. 짐승보다 사람을 막기 위해서다. 가진 것이 생기자 지킬 것이 생겼고, 파는 사람과 시키는 사람이 갈렸다."
  },
  "raid": {
   "title": "불탄 마을",
   "note": "부여 송국리 청동기 집터 가운데는 불에 탄 채 나온 것이 있다. 목책·환호·망대는 다른 마을과의 싸움이 있었다는 흔적이다. 곳간이 있는 마을이 노려졌다."
  },
  "lower": {
   "title": "목책 밖 집들",
   "note": "청동기 마을 안에서도 큰 집과 작은 집, 목책 안과 밖이 갈렸다. 논이 없는 집은 남의 논에서 품을 팔았다. 신분은 법보다 먼저 자리에서 생겼다."
  },
  "border": {
   "title": "경계",
   "note": "논이 생기자 「내 땅」이 생겼다. 마을과 마을 사이에 돌무더기와 창을 세워 경계를 그었고, 경계 다툼이 싸움이 됐다. 뒷날 나라의 국경은 여기서 시작한다."
  },
  "mortar": {
   "title": "찧는 자리",
   "note": "송국리에서는 불에 탄 쌀(탄화미)과 절구가 나온다. 거둔 벼는 찧어야 먹는다. 남의 논을 부치는 집은 거둔 것의 얼마를 논 주인에게 냈다 — 소작의 시작."
  },
  "spring": {
   "title": "샘",
   "note": "마을은 샘 곁에 선다. 가뭄에 샘이 줄면 누가 먼저 긷느냐가 자리가 된다. 물이 모자랄 때 사람의 자리가 가장 잘 보인다."
  },
  "gatewatch": {
   "title": "환호와 목책",
   "note": "청동기 마을은 둘레에 도랑(환호)을 파고 나무 울타리(목책)를 세웠다 — 울산 검단리·부여 송국리. 문은 하나, 지키는 사람이 있었다. 마을과 마을이 싸우기 시작한 때다."
  },
  "tin": {
   "title": "주석",
   "note": "청동은 구리에 주석을 섞어 만든다. 한반도에는 주석이 드물어 멀리서 들여와야 했다. 그래서 청동 칼과 거울은 아무나 못 가졌다 — 가진 사람이 우두머리였다."
  },
  "charcoal": {
   "title": "숯과 풀무",
   "note": "청동을 녹이려면 천 도가 넘는 불이 필요했다. 숯을 굽고 풀무로 바람을 넣고 돌 거푸집에 부었다. 숯 굽는 숲이 없으면 청동도 없다."
  },
  "plot": {
   "title": "밭 곡식",
   "note": "청동기 사람들은 벼만 심지 않았다. 밭에 조·수수·콩·보리를 길렀고 반달 돌칼로 이삭을 땄다. 논이 있는 집과 밭뙈기만 있는 집의 곳간이 달라졌다."
  },
  "tomb": {
   "title": "무덤 셋 — 고인돌·돌널·독",
   "note": "청동기 무덤은 셋이다. 큰 돌을 올린 고인돌(우두머리), 돌판 넷을 세워 상자처럼 만든 돌널무덤(보통 어른), 독 둘을 입 맞대 묻은 독무덤(주로 아이). 무덤 크기와 함께 묻은 물건(청동검·구슬)으로 그 사람이 살았을 때 자리가 보인다 — 죽어서도 자리가 남았다."
  },
  "quarry": {
   "title": "덮개돌은 어디서 왔나",
   "note": "고인돌 덮개돌은 몇 십 톤짜리도 있다. 바위 틈에 나무 쐐기를 박고 물을 부어 불려 떼어 낸 뒤, 통나무 굴림대 위에 올려 수백 명이 끌었다. 전남 화순·고창의 벼랑에는 떼어 낸 자국이 남아 있다. 돌이 큰 것은 그만큼 많은 사람을 부릴 수 있는 사람이 있었다는 뜻이다."
  },
  "jade": {
   "title": "옥 가는 집 — 대롱옥·곱은옥",
   "note": "청동기 사람들은 푸른 돌(천하석)을 갈아 대롱옥·곱은옥을 만들고 송곳으로 구멍을 뚫어 꿰었다. 경남 진주 대평리에서는 옥을 갈던 집터와 반쯤 간 옥이 나온다. 옥·청동검·청동거울은 아무나 못 가졌다 — 가진 집이 목에 걸어 자리를 보였다."
  }
 },
