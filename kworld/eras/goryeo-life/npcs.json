    "text": "땅을 나눈다. 아들과 딸, 같은 몫. 재혼해도 네 것이다.",
    "choices": [
     {
      "label": "같은 몫을 받는다",
      "gives": [
       "grain",
       "grain"
      ],
      "flag": "inherit:share",
      "say": "📜 논 문서. 「딸도 호주.」"
     },
     {
      "label": "재혼한다 — 흠이 아니다",
      "flag": "inherit:remarry",
      "say": "「재혼해도 네 땅은 네 것.」"
