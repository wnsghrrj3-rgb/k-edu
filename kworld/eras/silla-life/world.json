 "journal": {
  "golpum": {
   "title": "골품제",
   "note": "신라의 뼈 등급. 진골은 17등급 끝까지, 6두품은 6등급 아찬까지, 5두품은 10등급, 4두품은 12등급까지. 집 크기(24자·21자·18자·15자)와 옷 색(자주·붉은·푸른·노란)까지 뼈가 정했다."
  },
  "census": {
   "title": "신라 촌락문서",
   "note": "일본 쇼소인에서 나온 신라 마을 장부(755년쯤). 사람 수·소·말·뽕나무·잣나무 그루까지 3년마다 적었다. 세금은 그 숫자로 걷었다."
  },
  "exam": {
   "title": "독서삼품과",
   "note": "788년 원성왕. 국학에서 책 읽는 실력으로 상·중·하 셋을 뽑아 벼슬을 줬다 — 그러나 골품의 천장은 그대로였다."
  },
  "bulguksa": {
   "title": "불국사·석굴암",
   "note": "751년 김대성이 짓기 시작. 다보탑·석가탑·청운교. 토함산 석굴암의 돌 부처. 석가탑엔 백제 석공 아사달 이야기가 전한다(무영탑)."
  },
  "nogeup": {
   "title": "녹읍과 정전",
   "note": "진골은 마을째 세금을 받는 녹읍, 평민은 나라에서 받는 정전(722년 성덕왕). 신문왕이 녹읍을 없앴다가(689) 경덕왕 때 되살아났다(757) — 진골이 이겼다."
  },
  "chenghae": {
   "title": "장보고와 청해진",
   "note": "828년 흥덕왕이 장보고에게 완도 청해진을 맡겼다. 해적을 막고 당·일본과 장사했다. 841년 왕위 다툼에 끼었다가 죽임을 당하고 청해진은 851년 없어졌다."
  },
  "choe": {
   "title": "최치원",
   "note": "6두품. 12살에 당에 가 18살에 빈공과에 붙었다. 돌아와 시무 10조를 올렸으나 쓰이지 않았다. 「천장」을 가장 높이 친 사람."
  },
  "wonjong": {
   "title": "원종·애노의 난",
   "note": "889년 진성여왕 때 사벌주(상주)에서 세금을 못 내던 농민이 들고일어났다. 나라가 진압하지 못했다. 뒤이어 붉은 바지 도적(적고적)이 서울 가까이까지 왔다."
  },
  "balhae": {
   "title": "발해",
   "note": "698년 대조영. 고구려 사람과 말갈 사람의 나라. 당이 「해동성국」이라 불렀다. 일본에 사신을 서른 번 넘게 보냈다. 926년 거란에 망했고, 왕자 대광현이 고려로 왔다."
  },
  "husamguk": {
   "title": "후삼국",
   "note": "900년 견훤 후백제, 901년 궁예 후고구려, 918년 왕건 고려. 935년 신라 경순왕이 고려에 항복, 936년 후백제가 졌다. 왕건은 호족에게 성씨와 땅을 줬다."
  },
  "hojok": {
   "title": "호족",
   "note": "신라 말 지방에서 성을 쌓고 군사를 둔 사람들. 스스로 성주·장군이라 했다. 나라가 못 지키는 마을을 지켰고, 그 힘으로 고려의 문벌이 됐다."
  }
 },
