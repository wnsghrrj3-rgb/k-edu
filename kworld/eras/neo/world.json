 "journal": {
  "hoe": {
   "title": "돌괭이",
   "note": "돌을 갈판에 갈아 날을 세웠다. 깨는 게 아니라 간다 — 간석기."
  },
  "pottery": {
   "title": "빗살무늬토기",
   "note": "진흙을 빚어 불에 구웠다. 이제 담아 둘 수 있다."
  },
  "hut": {
   "title": "움집",
   "note": "땅을 파고 기둥을 세우고 갈대를 덮었다. 머물 집."
  },
  "grave": {
   "title": "함께 묻은 것",
   "note": "울진 후포리 신석기 무덤에서는 죽은 사람 곁에 간돌도끼를 여러 자루 함께 묻었다. 통영 연대도 조개더미에서는 조개 팔찌를 찬 사람 뼈가 나왔다. 머무니까 — 떠난 사람도 곁에 둔다."
  },
  "drifter": {
   "title": "아직 옮겨 다니는 사람들",
   "note": "모두가 한꺼번에 머문 것은 아니다. 신석기에도 사냥·채집을 따라 옮겨 다니는 무리가 있었고, 머무는 마을과 만나 물건을 주고받았다. 머묾은 「더 나은 것」이 아니라 「다른 길」이었다."
  },
  "sea": {
   "title": "바다로 나간 사람들",
   "note": "부산 동삼동 조개더미에서는 참치·상어·고래 뼈가 나온다. 창녕 비봉리의 통나무배는 8천 년 전 것. 울산 반구대 바위에는 고래를 잡는 배와 사람이 새겨져 있다. 신석기 사람은 강만이 아니라 바다에도 나갔다."
  },
  "tiger": {
   "title": "큰 짐승과 물",
   "note": "신석기 조개더미에서 호랑이·곰·멧돼지 뼈가 나온다. 마을은 울타리가 없었다. 큰 짐승이 내려오면 불을 키우고, 물 건너 섬이나 배로 피했다 — 물을 건너는 짐승은 드물다."
  },
  "slash": {
   "title": "숲을 태워 밭을",
   "note": "숲을 베고 태우면 재가 거름이 되고 햇빛이 든다. 이른 농사는 이렇게 숲 가장자리를 조금씩 밭으로 바꿨다고 보는 사람이 많다(화전). 바람을 잘못 보면 불은 숲으로 간다."
  },
  "layers": {
   "title": "같은 자리에 다시 짓다",
   "note": "서울 암사동에서는 움집 자리가 여러 층으로 겹쳐 나온다. 물이 오르면 떠나고, 다시 와서 같은 자리에 지었다. 머문다는 것은 한 번 머무는 것이 아니라 돌아오는 것이기도 했다."
  },
  "spindle": {
   "title": "실을 잣다",
   "note": "가운데 구멍 난 둥근 돌 — 가락바퀴. 막대에 꽂아 돌리면 칡·삼 섬유가 실이 된다. 뼈바늘로 꿰맨 옷, 꼰 실로 짠 그물. 신석기부터 사람은 가죽만 입지 않았다(암사동·동삼동 가락바퀴)."
  },
  "acornfall": {
   "title": "도토리",
   "note": "신석기 사람들은 도토리를 많이 먹었다. 떫은 맛은 물에 며칠 담가 뺐고, 갈돌과 갈판에 갈아 가루로 만들었다. 서울 암사동 움집 자리에서 탄 도토리가 나왔다."
  },
  "reedroof": {
   "title": "움집 지붕",
   "note": "움집은 땅을 파고 기둥을 세운 뒤 갈대·억새로 지붕을 덮었다. 가운데 화덕. 지붕이 새면 집이 아니다 — 갈대를 베려면 간돌도끼가 있어야 했다."
  },
  "lowland": {
   "title": "낮은 땅",
   "note": "마을은 강가 조금 높은 땅에 섰다. 낮은 땅은 흙이 좋아도 큰물이 올라왔다. 물 자국을 읽고 집 자리와 밭 자리를 나눴다."
  },
  "farvillage": {
   "title": "마을과 마을",
   "note": "강가 마을들은 서로 그릇·조개·흑요석을 주고받았다. 부산 동삼동 조개더미에서 일본 규슈의 흑요석과 조개 팔찌가 나왔다 — 배로 바다를 건너 오갔다."
  },
  "growvillage": {
   "title": "마을이 커진다",
   "note": "머물며 농사짓고 저장하니 먹을 것이 늘고 사람도 늘었다. 서울 암사동에서는 움집 터가 30채 가까이 나온다 — 한 집 두 집이 아니라 마을이다. 집이 늘면 터가 좁아지고, 가까운 곳에 새 터를 잡아 마을이 갈라지기도 했다."
  },
  "prayer": {
   "title": "비는 자리 — 토우와 조개 가면",
   "note": "울산 신암리에서 흙으로 빚은 작은 여인상(토우)이, 부산 동삼동 조개더미에서 눈·입을 뚫은 조개 가면과 조개 팔찌가 나온다. 머물며 농사를 짓자 비·해·땅에 비는 마음이 생겼다고 본다 — 무엇을 빌었는지는 기록이 없어 모른다."
  },
  "cavelife": {
   "title": "동굴에 산 사람들",
   "note": "춘천 교동 동굴에서는 신석기 사람 세 명의 뼈가 토기·석기와 함께 나왔다. 살던 굴이 그대로 무덤이 됐다. 모두가 강가 움집에 산 것은 아니다 — 겨울 바람을 막는 굴도 집이었다."
  }
 },
