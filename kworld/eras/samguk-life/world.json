 "journal": {
  "sickle": {
   "title": "돌낫",
   "note": "갈아 만든 돌 칼. 쇠 보습이 퍼져도 이삭은 돌낫으로 땄다."
  },
  "plow": {
   "title": "쇠 보습",
   "note": "쇠 날 보습. 삼국 시대엔 평민에게까지 퍼졌다. 수확이 늘자 나라도 더 거뒀다."
  },
  "ingot": {
   "title": "덩이쇠(철정)",
   "note": "가야는 쇠의 나라였다. 김해 대성동·양동리 무덤에서 납작한 덩이쇠가 수백 장 나온다. 돈처럼 쓰였고 왜·낙랑까지 팔렸다. 쇠가 많아 부유했지만, 하나로 뭉친 나라가 아니어서 신라에 하나씩 넘어갔다."
  },
  "cloth": {
   "title": "베 한 필",
   "note": "세금 셋 — 곡식·베·몸 — 중 하나. 집집의 여자가 짰다."
  },
  "code": {
   "title": "율령",
   "note": "나라의 법. 벼슬 등급과 옷 색, 세금, 벌을 정했다. 고구려 소수림왕(373), 백제 고이왕, 신라 법흥왕(520)."
  },
  "jindae": {
   "title": "진대법",
   "note": "194년 고구려 고국천왕·을파소. 봄에 나라 곡식을 빌려 주고 가을에 갚게 해, 가난한 사람이 귀족의 노비가 되는 것을 막았다."
  },
  "buddha": {
   "title": "불교",
   "note": "고구려 372 · 백제 384 · 신라 527(이차돈). 「왕은 곧 부처」 — 임금이 나라를 하나로 묶는 데 썼다."
  },
  "sunjang": {
   "title": "순장 금지",
   "note": "502년 신라 지증왕. 주인이 죽으면 종을 같이 묻던 것을 법으로 금했다. 노비에게 처음으로 법이 「살아라」고 했다."
  },
  "stele": {
   "title": "국경 비",
   "note": "진흥왕 순수비(북한산·창녕·황초령·마운령), 충주 고구려비. 「여긴 우리 땅」이라는 돌 글자."
  },
  "ureuk": {
   "title": "우륵",
   "note": "가야 사람. 가야금을 들고 신라로 갔다. 진흥왕이 받아 줬다. 장인·악사는 나라 사이를 건넜다."
  },
  "tally": {
   "title": "촌주의 셈",
   "note": "나라는 마을마다 촌주를 두어 세금을 셈하게 했다. 뒷날 신라 촌락문서에는 마을의 사람·소·뽕나무·논까지 적혀 있다. 촌주는 나라와 마을 사이에 섰다 — 덜 적으면 마을이, 더 적으면 나라가 고마워했다."
  },
  "school": {
   "title": "글을 배우는 집",
   "note": "고구려는 372년 태학을 세웠고, 지방 경당에서는 평민 자제도 글과 활을 배웠다. 백제는 오경박사가 가르쳤고 왜에 글을 전했다. 신라는 화랑도 안에서 배웠다. 글은 대개 남자, 그중에서도 귀족의 것이었다."
  },
  "shrine": {
   "title": "시조 제사",
   "note": "나라마다 나라를 세운 이에게 제사를 올렸다 — 고구려는 10월 동맹, 백제는 동명묘, 신라는 시조묘, 가야는 수로왕묘. 『삼국지』 위서 동이전은 고구려 동맹 때 온 나라 사람이 모여 술 마시고 노래하고 춤췄다고 적었다. 제사는 나라가 하나임을 보이는 날이었다."
  },
  "cave": {
   "title": "피난",
   "note": "한강을 두고 세 나라가 번갈아 싸웠다. 싸움이 오면 산성에 못 들어간 사람들은 산속 굴에 숨었다. 전쟁은 귀족에게 공을, 농민에게 피난과 부역을, 노비에게 도망칠 틈을 줬다."
  },
  "rebuild": {
   "title": "불탄 마을",
   "note": "한강 유역 마을은 여러 번 불탔다. 몽촌토성·아차산 보루에서 불에 탄 집터가 나온다. 전쟁이 지나가면 남은 사람이 집을 다시 세웠다 — 귀족은 사람을 시켰고, 농민은 제 손으로, 장인은 기와를 올렸다."
  },
  "beacon": {
   "title": "봉화",
   "note": "산성과 산성 사이에서 연기와 불로 적을 알렸다. 틀이 갖춰진 봉수는 고려·조선 것이지만, 삼국 산성 유적에도 불 피운 자리가 남아 있다. 봉화 하나가 늦으면 성 하나가 넘어갔다."
  }
 },
