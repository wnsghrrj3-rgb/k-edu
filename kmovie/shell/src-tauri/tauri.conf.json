{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KMovie",
  "version": "0.1.0",
  "identifier": "com.keduclass.kmovie",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "K-edu",
    "shortDescription": "케이무비 — 케이에듀 영상 편집기 (데스크톱판)",
    "longDescription": "keduclass.com/kmovie 를 여는 창에 ffmpeg 가 붙어, 무거운 원본(HEVC·4K)을 프록시로 바꿔 편집하고 내보내기는 원본 화질로 렌더합니다. 케이에듀에 접속해야만 열립니다.",
    "copyright": "© K-edu. ffmpeg (LGPL v2.1+) 동봉 — 라이선스는 LICENSE-ffmpeg.txt",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
